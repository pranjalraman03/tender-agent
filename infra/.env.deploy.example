# Copy to infra/.env.deploy on the server and fill in. NEVER commit infra/.env.deploy.
# Docker reads values literally: keep comments on their own lines, never after a value.
# Generate secrets with:  openssl rand -base64 32   (use letters/digits only for DB passwords:
#                         openssl rand -hex 24)

# --- Public address (what users type in the browser) --------------------------------------
PUBLIC_URL=https://tenders.example.com
WEB_PORT=3000

# --- Database ------------------------------------------------------------------------------
# owner account, used only by the migrate service
POSTGRES_PASSWORD=
# tender_app account used by the app (>= 16 chars)
APP_DB_PASSWORD=

# --- Auth (shared by web and API) ----------------------------------------------------------
AUTH_SECRET=
ADMIN_EMAILS=["you@example.com"]
# Sign-in methods (development login is always off in this stack): set at least one.
# email magic links (also used for the daily digest)
RESEND_API_KEY=
EMAIL_FROM=Tender Agent <login@example.com>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- LLM -----------------------------------------------------------------------------------
# or openai_compat (e.g. Groq)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=

# --- Storage (default: files in the `storage` volume; R2 when ready) ------------------------
STORAGE_BACKEND=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=tender-docs
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Crawler / observability ---------------------------------------------------------------
CRAWLER_USER_AGENT=TenderAgentBot/0.1 (+mailto:you@example.com)
SENTRY_DSN=
