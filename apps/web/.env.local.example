# Next.js server-side settings. Copy to .env.local.
API_URL=http://localhost:8000
# Must equal AUTH_SECRET in the repo-root .env (FastAPI verifies the tokens this app signs).
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
# Auth.js tables live in the `auth` schema of the same Postgres.
AUTH_DATABASE_URL=postgres://tender:tender@localhost:5433/tender
# Local development: sign in with just an email address (never enable in production).
AUTH_DEV_LOGIN=true
# Email magic links (optional locally): Resend API key + verified sender.
AUTH_RESEND_KEY=
EMAIL_FROM=Tender Agent <login@example.com>
# Google sign-in (optional locally).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
