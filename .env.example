# Copy to .env and fill in. Never commit .env. Blank values fall back to defaults.
APP_ENV=local

# Local default matches infra/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5433/tender

# --- Storage ------------------------------------------------------------------------
# local = files under STORAGE_LOCAL_DIR (no keys needed). s3 = Cloudflare R2:
#   STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   R2 dashboard -> R2 -> Manage API tokens -> create token with Object Read & Write.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=tender-docs
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Claude API (console.anthropic.com -> API keys; billed separately from Claude Pro) ---
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-sonnet-5-5     # extraction, classification, verification
LLM_MODEL_STRONG=claude-opus-5-5     # eligibility check
LLM_REFUSAL_FALLBACK=true

# --- Embeddings / rerank ---------------------------------------------------------
# local = ONNX models on this machine (no key). voyage = hosted (set the keys + models).
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024                   # must match vector(...) columns in migrations
RERANK_PROVIDER=local
RERANK_API_KEY=
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Auth (shared by Next.js and FastAPI) ------------------------------------------
AUTH_SECRET=                         # generate: openssl rand -base64 32; same value in apps/web/.env.local
ADMIN_EMAILS=[]                      # JSON list, e.g. ["you@example.com"] -> admin role
CORS_ORIGINS=["http://localhost:3000"]

# --- Email (optional locally: without a key, emails are written to the log) --------
RESEND_API_KEY=
EMAIL_FROM=Tender Agent <digest@example.com>
WEB_BASE_URL=http://localhost:3000

# --- Observability (optional) --------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

CRAWLER_USER_AGENT="TenderAgentBot/0.1 (+mailto:you@example.com)"   # honest UA with a contact address
