# Copy to .env and fill in. Never commit .env.
APP_ENV=local

# Local default matches infra/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5433/tender

# S3-compatible bucket (MinIO locally)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=tender-docs
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

ANTHROPIC_API_KEY=
LLM_MODEL_FAST=          # extraction, classification, verification
LLM_MODEL_STRONG=        # eligibility check

EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024       # must match vector(...) columns in migrations

RERANK_API_KEY=
RERANK_MODEL=

AUTH_SECRET=             # shared by Auth.js and FastAPI JWT verification

RESEND_API_KEY=
EMAIL_FROM=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

SENTRY_DSN=

CRAWLER_USER_AGENT="TenderAgentBot/0.1 (+mailto:you@example.com)"   # honest UA with a contact address
